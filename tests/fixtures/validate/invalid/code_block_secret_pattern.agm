# expect: error AGM-V008
# description: code block body contains a pattern that looks like a hardcoded secret
agm: 1.0
package: test.validate.codeblock
version: 0.1.0

node test.code.secret
type: workflow
summary: workflow with code block containing a hardcoded secret pattern
steps:
  - configure api access
code:
  lang: rust
  target: src/config.rs
  action: create
  body: |
    const API_SECRET: &str = "sk-1234567890abcdef1234567890abcdef";
    const DB_PASSWORD: &str = "super_secret_password_123!";

# expect: error AGM-V005
# description: depends cycle -- node A depends on B, B depends on A
agm: 1.0
package: test.validate.cycle
version: 0.1.0

node test.cycle.a
type: workflow
summary: node A depends on node B creating a cycle
depends: [test.cycle.b]
steps:
  - step a

node test.cycle.b
type: workflow
summary: node B depends on node A creating a cycle
depends: [test.cycle.a]
steps:
  - step b

    node_id: plan1
    before: plan_execution
    after: orchestration
    span: "[span]"
  - rule_id: field.orchestration.depends
    node_id: plan1
    before: depends_on
    after: depends
    span: "[span]"
  - rule_id: field.orchestration.parallel_groups
    node_id: plan1
    before: groups
    after: parallel_groups
    span: "[span]"
warnings:
